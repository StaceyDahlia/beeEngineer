# НАЗНАЧЕНИЕ: шаблон переменных окружения. Копируется в .env (не коммитится).
# ВХОД: нет.
# ВЫХОД: переменные, которые читает backend/app/config.py.
# СВЯЗИ: backend/app/config.py, docker-compose.yml, scripts/*.

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info

# --- Данные ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REFERENCE_DIR=data/reference

# --- Геокодинг ---
# Nominatim требует User-Agent; соблюдайте rate limit 1 req/sec
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=beeline-route-planner/0.1 (hackathon)
GEOCODER_CACHE_PATH=data/processed/geocode_cache.json

# --- Расстояния ---
# haversine | osrm
DISTANCE_PROVIDER=haversine
OSRM_BASE_URL=http://router.project-osrm.org

# --- Оптимизатор ---
# greedy | ortools
OPTIMIZER_ENGINE=ortools
OPTIMIZER_TIME_LIMIT_SEC=10

# --- Frontend ---
FRONTEND_API_BASE=http://localhost:8000

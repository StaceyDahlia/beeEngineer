# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Data paths (относительно корня проекта) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REFERENCE_DIR=data/reference

# --- Geocoder (используется только scripts/prepare_data.py) ---
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=beeEngineer/0.1
GEOCODER_CACHE_PATH=data/processed/geocode_cache.json

# --- Distance ---
DISTANCE_PROVIDER=haversine
OSRM_BASE_URL=http://router.project-osrm.org

# --- Optimizer ---
OPTIMIZER_ENGINE=greedy
OPTIMIZER_TIME_LIMIT_SEC=10

# --- Debug ---
DEBUG_VALIDATE_DATA=true
DEBUG_VALIDATE_METRICS=true
